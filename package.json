{
  "name": "com.joaomgcd.join",
  "productName": "Join Desktop",
  "homepage": "https://joaoapps.com/join/desktop",
  "version": "1.2.0",
  "description": "A companion app for the Join website",
  "main": "main_esm.js",
  "scripts": {
    "postinstall": "install-app-deps",
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "makemac": "electron-installer-dmg",
    "pack": "electron-builder build --dir",
    "dist": "electron-builder build"
  },
  "keywords": [
    "Join",
    "Android"
  ],
  "author": {
    "name": "joaomgcd",
    "email": "support@joaoapps.com"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.2.0",
    "@electron-forge/maker-deb": "^7.2.0",
    "@electron-forge/maker-dmg": "^7.2.0",
    "@electron-forge/maker-rpm": "^7.2.0",
    "@electron-forge/maker-squirrel": "^7.2.0",
    "@electron-forge/maker-zip": "^7.2.0",
    "electron": "^41.5.0",
    "electron-builder": "^26.8.1",
    "electron-installer-dmg": "^4.0.0"
  },
  "dependencies": {
    "auto-launch": "^5.0.5",
    "electron-fetch": "^1.7.3",
    "electron-squirrel-startup": "^1.0.0",
    "http-terminator": "2.0.3",
    "network": "^0.7.0",
    "node-fetch": "^2.6.0",
    "node-notifier": "^10.0.1"
  },
  "build": {
    "asarUnpack": [
      "./node_modules/node-notifier/**"
    ],
    "appId": "com.joaomgcd.join",
    "mac": {
      "icon": "build/icon.icns",
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        },
        {
          "target": "zip",
          "arch": ["x64", "arm64"]
        }
      ],
      "category": "public.app-category.utilities",
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "contents": [
        {
          "x": 110,
          "y": 150
        },
        {
          "x": 240,
          "y": 150,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "linux": {
      "icon": "build/icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "win": {
      "target": [
        "portable",
        "squirrel"
      ],
      "icon": "build/icon.ico"
    },
    "portable": {
      "artifactName": "join_portable.exe"
    },
    "squirrelWindows": {
      "loadingGif": "joinloading.png"
    }
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "out": "dist",
        "arch": ["x64", "arm64"],
        "icon": "./join"
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "com.joaomgcd.join",
            "iconUrl": "https://raw.githubusercontent.com/markwal/GpxUi/master/gpx.ico",
            "loadingGif": "joinloading.png",
            "setupIcon": "join.ico"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ],
          "icon": "./join.png"
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-dmg",
          "config": {
            "background": "./images/account_background.png",
            "icon": "./join.icns",
            "format": "ULFO"
          }
        }
      ]
    }
  }
}
